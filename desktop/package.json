{
  "name": "glow-desktop",
  "productName": "Glow",
  "private": true,
  "version": "2.13.8",
  "description": "Glow for Windows: the Electron shell that hosts Glow (web/) and gives it Bluetooth, screen capture and updates.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-web.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.voidqubex.glow.desktop",
    "productName": "Glow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Glow-Desktop-${version}.exe"
    }
  },
  "allowScripts": {
    "electron@33.2.1": true
  }
}
