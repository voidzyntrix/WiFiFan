{
  "name": "glow-desktop",
  "productName": "Glow",
  "private": true,
  "version": "1.1.0",
  "description": "Glow for Windows: control the WiFiFan LED board over Bluetooth.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win portable",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/web-bluetooth": "0.0.20",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "build": {
    "appId": "io.github.voidqubex.glow.desktop",
    "productName": "Glow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Glow-Desktop-${version}.exe"
    }
  },
  "allowScripts": {
    "electron@33.2.1": true,
    "esbuild@0.21.5": true
  }
}
