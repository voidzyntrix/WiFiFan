{
  "name": "glow-web",
  "private": true,
  "version": "2.13.59",
  "description": "Glow: the one app behind Glow for Android and Glow for Windows (React + TypeScript). The native shells (app/ for Android, desktop/ for Windows) host this build.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.1.0",
    "@material/material-color-utilities": "0.3.0",
    "mdui": "^2.1.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/web-bluetooth": "0.0.20",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
